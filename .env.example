IPMI_HOST=192.168.1.100
IPMI_USER=admin
IPMI_PASS=password
TARGET_SERVER_URL=http://192.168.1.101:8080
HEALTH_PATH=/health
IDLE_TIMEOUT=3600
SHUTDOWN_ENABLED=true

# --- Queuing ---
# How many distinct sessions may run against the target at once.
CONCURRENT_SESSIONS=1
# Max in-flight requests per session: -1 = unlimited, N = cap, 0 = serialize.
CONCURRENT_SESSION_REQUESTS=-1
# How spot-holding sessions share the model:
# parallel = each session may run its requests at the same time (default);
# atomic   = at most ONE request in-flight globally at a time (sessions and
#            their spots still overlap, but the requests alternate FIFO).
REQUEST_MODE=parallel
# Requests matching no known API (OpenAI /v1/*, Anthropic /v1/messages):
# allow = pass through unqueued (listed on /monitor), block = reject with 403.
UNKNOWN_API_POLICY=allow
# Seconds a session may stay idle before its spot is released and it is
# forgotten (future requests queue at the back as new).
SESSION_EXPIRY=300
# Unknown clients (no status API) are considered busy this long after their
# last request.
CLIENT_BUSY_WINDOW=120
# Seconds between polls of known clients' status APIs (e.g. opencode's
# GET /session/status).
CLIENT_STATUS_POLL=5
# Max seconds a request may wait in the queue before a 504. 0 = no timeout.
QUEUE_TIMEOUT=0
# Port of the opencode server probed on each client's source IP. Clients
# must run opencode on a reachable interface, e.g.
#   opencode serve --hostname 0.0.0.0 --port 4096
OPENCODE_STATUS_PORT=4096
# Optional basic-auth password for opencode servers (user is "opencode").
OPENCODE_SERVER_PASSWORD=
# Generic fallback session headers (comma separated), checked after a known
# client's own header (x-opencode-session) and before API body fields.
SESSION_ID_HEADERS=x-session-id
